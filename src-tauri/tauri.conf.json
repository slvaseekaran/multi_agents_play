{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Dashboard",
  "version": "0.1.0",
  "identifier": "com.local.agentdashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Agent Dashboard", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "center": true, "maximized": true, "backgroundColor": "#020a05" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
